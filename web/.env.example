# Salin ke .env.local. Untuk VPS, ambil nilai dengan `sh run.sh secrets`
# dari stack self-hosted Supabase. Jangan commit nilai asli.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Hanya server: jangan beri awalan NEXT_PUBLIC_ dan jangan kirim ke browser.
SUPABASE_SERVICE_ROLE_KEY=
